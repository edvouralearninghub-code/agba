{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build:api": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "build": "vite build && npm run build:api",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:rules": "npx eslint firestore.rules",
    "bootstrap:appwrite": "tsx scripts/bootstrap-appwrite.ts",
    "check:no-firestore": "tsx scripts/check-no-firestore-imports.ts",
    "migrate:firestore": "tsx scripts/migrate-firestore-to-appwrite.ts",
    "report:appwrite-scope": "tsx scripts/report-appwrite-memory-and-backup-scope.ts",
    "verify:appwrite-live": "tsx scripts/verify-appwrite-integration.ts",
    "verify:phase0": "tsx scripts/verify-phase0.ts",
    "docker:app:up": "docker compose up -d --build",
    "docker:app:down": "docker compose down",
    "docker:up": "cp -n infra/appwrite/env.template infra/appwrite/.env 2>/dev/null || true && docker compose --project-directory infra/appwrite --env-file infra/appwrite/.env -f infra/appwrite/docker-compose.yml -f infra/agba-extras.docker-compose.yml up -d",
    "docker:down": "docker compose --project-directory infra/appwrite --env-file infra/appwrite/.env -f infra/appwrite/docker-compose.yml -f infra/agba-extras.docker-compose.yml down",
    "docker:logs": "docker compose --project-directory infra/appwrite --env-file infra/appwrite/.env -f infra/appwrite/docker-compose.yml -f infra/agba-extras.docker-compose.yml logs -f",
    "cloud:bootstrap": "APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1 APPWRITE_PROJECT_ID=6adc7d7a000b5b27d58d tsx scripts/bootstrap-appwrite.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
